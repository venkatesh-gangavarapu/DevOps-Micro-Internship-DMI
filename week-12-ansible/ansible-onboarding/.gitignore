*vault*pass*

# SSH keys (never commit private keys)
*.pem
*.key
id_rsa
id_ed25519
id_ecdsa

# Secrets / environment files
.env
.env.*
secrets.yml
secrets.yaml

# Logs
*.log
logs/

# OS artifacts
.DS_Store
Thumbs.db

# Editor artifacts
*.swp
*.swo
*~
.idea/

# pre-commit cache
.pre-commit-cache/
