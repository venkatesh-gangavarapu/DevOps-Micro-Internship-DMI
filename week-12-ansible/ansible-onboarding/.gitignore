# Python virtual environment
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd

# Ansible runtime artifacts
*.retry
.ansible/
inventories/host_vars/*/vault.yml
inventories/group_vars/*/vault.yml

# Ansible Vault password files (never commit these)
.vault_pass
.vault_password
vault_pass.txt
