# Dependencies — reinstalled fresh inside container
node_modules

# Previous build output — rebuilt inside container
build

# Git history — not needed in image
.git
.gitignore

# Environment files — never bake secrets into images
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker files themselves
Dockerfile
Dockerfile.single
.dockerignore

# Editor and OS files
.DS_Store
*.swp
*.swo
